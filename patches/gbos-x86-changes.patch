 # Harmless if the file is missing; hook.sh patches later anyway.
 [ -f /gbos/gbos/early_patch.sh ] && . /gbos/gbos/early_patch.sh
 
+# QUIET_BOOT=1 (default): no kernel/init text on the screen from the moment the drive is found until the boot animation, and
+# none at shutdown or restart (gbos/quiet_boot.sh). Everything is still logged to logs/boot-N/kmsg.log. 0 = show the text.
+#QUIET_BOOT=0
