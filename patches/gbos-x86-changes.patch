@@ -68,10 +69,29 @@ MODOPTS="mt7921_common.disable_clc=1"
 # so quick flicks do nothing. By default each internal touchpad gets an IDC file with Change_Timeout=0.02. Takes effect after a boot.
 #TOUCHPAD_FLICK=0
 
+# FINGERPRINT=0 turns off gbos_fp, the fingerprint HAL for Synaptics match-on-chip USB sensors (ThinkPad X13 Gen 2i: 06cb:00f9).
+# By default it runs only when such a sensor is found at boot. It is a WEAK (Class 2) sensor: it unlocks the lock screen and
+# signs in to apps that accept weak biometrics, but cannot unlock Keystore keys. Takes effect after a boot.
+#FINGERPRINT=0
+
+# TB_NET=0 turns off Thunderbolt networking (thunderbolt_net + usb/tbnet.sh): a Thunderbolt/USB4 cable to another computer
+# becomes a network link, this side TB_NET_IP/24, so adb can run over the cable (give the other side 10.42.0.1/24, then
+# adb connect 10.42.0.2:<port>). On by default on machines whose Thunderbolt driver loads. Takes effect after a boot.
+#TB_NET=0
+#TB_NET_IP=10.42.0.2
+
