+# Google's partitions name the device (lapis: ASUS / "ASUS Googlebook 14") in ro.product.<partition>.brand, .manufacturer, .model
+# and .marketname of vendor, product, odm, odm_dlkm, system_ext, system_dlkm and vendor_dlkm. DEVICE_BRAND / DEVICE_MODEL replace
