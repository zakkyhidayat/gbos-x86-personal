 # Google's image renders through ANGLE -> Vulkan, and its only Vulkan driver is Intel's ANV (/vendor/lib64/hw/vulkan.intel.so);
 # buffers come from minigbm (gralloc, /vendor/lib64/libminigbm_gralloc.so), which has no amdgpu backend. On a laptop whose GPU
@@ -213,9 +235,31 @@ gbos_touchpads() {
     if (name ~ /touchpad|trackpad/ && bus != "0003" && v != "" && p != "") print tolower(v) ":" tolower(p)
   }' ${INPUTS:-/proc/bus/input/devices} 2>/dev/null | sort -u
 }
+# "06cb:pppp" of the first Synaptics match-on-chip fingerprint sensor on USB, else nothing. The product ids are fingerprint/syn.h's
+# (libfprint's synaptics table); tools/test_gbos_fp.sh checks the two lists match. USBDEVS= is only for tests.
+GBOS_FP_PIDS="00bd 00c2 00c4 00c6 00df 00e9 00f0 00f9 00fc 0100 0103 0104 0106 0107 0108 0109 010a 010b 010d 010e 0123 0124 0126 0129 015f 0168 0169 016c 0173 0174 019d 019f 01a0 01a4"
+gbos_synaptics_fp() {
+  for d in ${USBDEVS:-/sys/bus/usb/devices}/*; do
+    [ "$(cat $d/idVendor 2>/dev/null)" = 06cb ] || continue
+    p=$(cat $d/idProduct 2>/dev/null)
+    case " $GBOS_FP_PIDS " in *" $p "*) echo "06cb:$p"; return;; esac
+  done
+}
 if mount --bind /gbos /new/postinstall; then
   mkdir -p /tmp/sysinit && cp -a /new/system/etc/init/. /tmp/sysinit/
