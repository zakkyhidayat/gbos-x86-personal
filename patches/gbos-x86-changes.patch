+# Thunderbolt networking: thunderbolt_net (CONFIG_USB4_NET, left out of the shipped kernel; built for it by
+# kernel/isa_emu_patch/build_extra_module.sh into gbos/kmod/) turns a Thunderbolt/USB4 cable to another computer into a
+# network link (thunderbolt0), which gbos_tbnet (usb/tbnet.sh) addresses for adb over the cable. The peer can appear any
+# time after boot, so the driver is loaded now on every machine whose Thunderbolt driver came up. TB_NET=0 turns it off.
+TBRC=
+if [ "${TB_NET:-1}" != 0 ] && [ -f $G/kmod/thunderbolt_net.ko ] && grep -q '^thunderbolt ' /proc/modules; then
+  if insmod $G/kmod/thunderbolt_net.ko; then
+    log "hook: thunderbolt_net loaded, link address ${TB_NET_IP:-10.42.0.2}"
+    TBRC="# Thunderbolt network link for adb over the cable (usb/tbnet.sh).
+service gbos_tbnet /system/bin/sh /postinstall/gbos/tbnet.sh ${TB_NET_IP:-10.42.0.2}
+    user root
+    group root inet
+    seclabel u:r:shell:s0
+    oneshot
+    disabled
+on property:sys.boot_completed=1
+    start gbos_tbnet"
+  else
+    log "hook: thunderbolt_net load FAILED: $(dmesg | grep -iE 'thunderbolt_net|disagrees|Unknown symbol' | tail -2 | tr '\n' ' ')"
+  fi
+fi
+
