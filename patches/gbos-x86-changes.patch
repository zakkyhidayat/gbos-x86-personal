 grep -q '^ro.sf.lcd_density=180$' "$W/out.prop" && ok "DENSITY still applied" || bad "DENSITY not applied"
 
+# the identity rewrite over all partitions' build.prop files (DEVICE_BRAND / DEVICE_MODEL), whatever value Google used
+awk '/^case "\$DEVICE_BRAND\$DEVICE_MODEL" in/{p=1} p{print} p&&/^fi$/{exit}' "$ROOT/usb/hook.sh" \
+  | sed -e "s#/new/#$W/new/#g" -e "s#/tmp/ident#$W/ident#g" -e 's#mount --bind \$N \$P#cp $N $P#' > "$W/ident.sh"
+[ -s "$W/ident.sh" ] && ok "identity block extracted from hook.sh" || bad "identity block not found in hook.sh"
+mkprops() {	# a build.prop per partition, with a name that is not lapis's ASUS one
+  for d in vendor product/etc vendor/odm/etc vendor/odm_dlkm/etc system_ext/etc system_dlkm/etc vendor_dlkm/etc; do
+    mkdir -p "$W/new/$d"; p=$(echo "$d" | sed 's#/etc##; s#.*/##')
+    printf 'ro.product.%s.brand=Acme\nro.product.%s.manufacturer=Acme\nro.product.%s.model=Acme Book 15\nro.product.%s.device=lapis\nro.%s.build.fingerprint=Acme/lapis/lapis:17/X/1:user/release-keys\n' \
+      "$p" "$p" "$p" "$p" "$p" > "$W/new/$d/build.prop"
+  done
+}
+allprops() { cat "$W/new/vendor/build.prop" "$W"/new/*/etc/build.prop "$W"/new/vendor/*/etc/build.prop; }
+mkprops
+( log() { :; }; DEVICE_BRAND=LENOVO; DEVICE_MODEL="ThinkPad X13 Gen 2i"; . "$W/ident.sh" )
+[ "$(allprops | grep -c '\.brand=LENOVO$')" = 7 ] && [ "$(allprops | grep -c '\.manufacturer=LENOVO$')" = 7 ] && ok "identity: brand/manufacturer replaced in all 7 partitions, whatever the old value" || bad "identity: brand not replaced everywhere"
+[ "$(allprops | grep -c '\.model=ThinkPad X13 Gen 2i$')" = 7 ] && ok "identity: model replaced in all 7 partitions" || bad "identity: model not replaced everywhere"
+allprops | grep 'Acme' | grep -qv 'fingerprint=' && bad "identity: an old name survived outside the fingerprints" || ok "identity: no old name left except in fingerprints"
+[ "$(allprops | grep -c 'fingerprint=Acme/lapis')" = 7 ] && [ "$(allprops | grep -c '\.device=lapis$')" = 7 ] && ok "identity: fingerprints and device=lapis untouched" || bad "identity: fingerprint or device changed"
+mkprops
+( log() { :; }; DEVICE_BRAND=; DEVICE_MODEL="Only Model"; . "$W/ident.sh" )
+grep -q '^ro.product.product.brand=Acme$' "$W/new/product/etc/build.prop" && grep -q '^ro.product.product.model=Only Model$' "$W/new/product/etc/build.prop" && ok "identity: DEVICE_BRAND unset keeps the brand, model still replaced" || bad "identity: partial settings wrong"
+mkprops
+( log() { :; }; DEVICE_BRAND="A/B"; DEVICE_MODEL="X"; . "$W/ident.sh" )
+grep -q '^ro.product.product.model=Acme Book 15$' "$W/new/product/etc/build.prop" && ok "identity: values with / refused, files untouched" || bad "identity: unsafe value applied"
+
 # the service that sets the Settings "Device name"
 H=$ROOT/usb/hook.sh
 grep -qF "settings put global device_name '\$DEVICE_MODEL'" "$H" && ok "hook: gbos_devname sets Settings.Global.device_name" || bad "hook: no device_name service"
